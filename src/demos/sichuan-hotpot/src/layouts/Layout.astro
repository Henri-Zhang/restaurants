---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Spice Pit — Sichuan Hotpot",
  description = "Tableside bubbling pots, 18 spices in the broth, late-night energy. The numbing-spicy hotpot experience, done right.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #0c0a09;
    --charcoal: #1a1411;
    --crimson: #c1121f;
    --crimson-deep: #780000;
    --ember: #f4a261;
    --gold: #e9c46a;
    --chili: #e63946;
    --cream: #fdf6ec;
    --paper: #f7eede;
    --ink-muted: #8a7a6a;
    --border: rgba(255, 255, 255, 0.08);
    --border-strong: rgba(233, 196, 106, 0.25);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica,
      Arial, sans-serif;
    color: var(--cream);
    background: var(--ink);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4 {
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section {
    padding: 72px 0;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 30px;
    border-radius: 4px;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease,
      box-shadow 0.15s ease;
    cursor: pointer;
    border: none;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn--fire {
    background: var(--crimson);
    color: #fff;
    box-shadow: 0 4px 20px rgba(193, 18, 31, 0.35);
  }
  .btn--fire:hover {
    background: var(--chili);
    box-shadow: 0 6px 28px rgba(230, 57, 70, 0.45);
  }
  .btn--gold {
    background: transparent;
    color: var(--gold);
    border: 1.5px solid var(--gold);
  }
  .btn--gold:hover {
    background: var(--gold);
    color: var(--ink);
  }
  .btn--ember {
    background: var(--ember);
    color: var(--charcoal);
  }
  .btn--ember:hover {
    background: #f0b378;
  }

  @media (max-width: 768px) {
    .section {
      padding: 52px 0;
    }
  }
</style>
