---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import menu from "../data/menu.json";

const categories = menu.categories;
const base = import.meta.env.BASE_URL;

const tagLabel: Record<string, string> = {
  spicy: "Spicy",
  mild: "Mild",
  signature: "Signature",
  premium: "Premium",
  vegetarian: "Veggie",
  vegan: "Vegan",
  "gluten-free": "GF",
  "high-protein": "High Protein",
};

// Heat inferred from the first heat-laden tag.
const heatOf = (tags: string[]) => {
  if (tags.includes("spicy") || tags.includes("signature")) return 3;
  if (tags.includes("premium")) return 2;
  if (tags.includes("mild")) return 0;
  return 1;
};

const heatMeter = (n: number) =>
  `<span class="hd">🌶</span>`.repeat(n);
---

<Layout title="Menu — Spice Pit">
  <Header />

  <!-- Menu hero -->
  <section class="menu-hero">
    <div class="container">
      <p class="eyebrow">Hotpot Menu</p>
      <h1>Build the pot<br />your way.</h1>
      <p class="menu-hero-sub">
        Pick a broth, then load up. Every item below is ordered at the table
        and delivered raw for you to cook. When in doubt, ask the pot captain
        — they will tell you the exact number of seconds.
      </p>
    </div>
  </section>

  <!-- Menu body: sticky rail + horizontal rows -->
  <section class="menu-body">
    <div class="container menu-grid">
      <aside class="menu-rail">
        <span class="rail-label">Categories</span>
        <nav class="rail-nav">
          {categories.map((cat) => (
            <a href={`#${cat.name.toLowerCase().replace(/[^a-z]+/g, "-")}`}>
              {cat.name}
              <span class="rail-count">{cat.items.length}</span>
            </a>
          ))}
        </nav>
        <a href={`${base}#book`} class="rail-cta">Book a pot →</a>
      </aside>

      <div class="menu-list">
        {categories.map((cat, idx) => (
          <section
            class="menu-cat"
            id={cat.name.toLowerCase().replace(/[^a-z]+/g, "-")}
            style={idx > 0 ? "padding-top: 56px;" : ""}
          >
            <header class="cat-head">
              <span class="cat-index">{String(idx + 1).padStart(2, "0")}</span>
              <h2>{cat.name}</h2>
              <span class="cat-count">{cat.items.length} items</span>
            </header>

            <ul class="cat-items">
              {cat.items.map((item) => (
                <li class="item-row">
                  <div class="item-main">
                    <h3>{item.name}</h3>
                    <p>{item.desc}</p>
                    <div class="item-tags">
                      {item.tags.map((tag) => (
                        <span class:list={["tag", `tag--${tag}`]}>
                          {tagLabel[tag] ?? tag}
                        </span>
                      ))}
                    </div>
                  </div>
                  <div class="item-side">
                    <span class="item-heat" set:html={heatMeter(heatOf(item.tags))}></span>
                    <span class="item-cal">
                      {item.calories > 0 ? `${item.calories} cal` : "Broth base"}
                    </span>
                    <span class="item-price">{item.price}</span>
                    <a href={`${base}#book`} class="item-add">+ Add</a>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}

        <!-- Final CTA pinned to the list -->
        <div class="list-cta">
          <div>
            <h3>Still deciding?</h3>
            <p>Let the pot captain walk you through it — they love this part.</p>
          </div>
          <a href={`${base}#book`} class="btn btn--fire">Book a pot →</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Menu hero (compact, distinct from index hero) */
  .menu-hero {
    background:
      radial-gradient(ellipse at 50% 0%, rgba(193, 18, 31, 0.28), transparent 60%),
      var(--ink);
    color: var(--cream);
    padding: 72px 0 44px;
    text-align: center;
  }
  .menu-hero .eyebrow { margin-bottom: 12px; }
  .menu-hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1;
    margin-bottom: 16px;
  }
  .menu-hero-sub {
    max-width: 580px;
    margin: 0 auto;
    opacity: 0.7;
    font-size: 0.98rem;
  }

  /* Menu body layout: sticky rail + list */
  .menu-body { padding: 48px 0 80px; background: var(--ink); }
  .menu-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 56px;
    align-items: start;
  }

  /* Rail */
  .menu-rail {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .rail-label {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .rail-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 1px solid var(--border);
    padding-left: 16px;
  }
  .rail-nav a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 0;
    color: rgba(253, 246, 236, 0.55);
    font-size: 0.92rem;
    font-weight: 600;
    transition: color 0.15s ease;
    border-bottom: 1px solid transparent;
  }
  .rail-nav a:hover {
    color: var(--gold);
  }
  .rail-count {
    font-size: 0.72rem;
    color: var(--ink-muted);
    font-weight: 700;
  }
  .rail-cta {
    margin-top: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    background: var(--crimson);
    color: #fff;
    border-radius: 4px;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .rail-cta:hover { background: var(--chili); }

  /* Category header inside the list */
  .menu-cat { scroll-margin-top: 96px; }
  .cat-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border-strong);
    margin-bottom: 8px;
  }
  .cat-index {
    font-size: 0.86rem;
    font-weight: 800;
    color: var(--crimson);
    letter-spacing: 0.04em;
  }
  .cat-head h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    color: var(--cream);
  }
  .cat-count {
    margin-left: auto;
    font-size: 0.78rem;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
  }

  /* Item rows: horizontal, not 2-col cards */
  .cat-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .item-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: start;
    padding: 24px 4px;
    border-bottom: 1px solid var(--border);
    transition: background 0.2s ease;
  }
  .item-row:hover { background: rgba(193, 18, 31, 0.04); }
  .item-main h3 {
    font-size: 1.1rem;
    color: var(--cream);
    margin-bottom: 6px;
  }
  .item-main p {
    color: rgba(253, 246, 236, 0.55);
    font-size: 0.86rem;
    line-height: 1.5;
    margin-bottom: 10px;
    max-width: 560px;
  }
  .item-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.66rem;
    font-weight: 800;
    padding: 3px 9px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: rgba(233, 196, 106, 0.12);
    color: var(--gold);
  }
  .tag--spicy { background: rgba(230, 57, 70, 0.18); color: var(--chili); }
  .tag--signature { background: rgba(244, 162, 97, 0.18); color: var(--ember); }
  .tag--premium { background: rgba(233, 196, 106, 0.18); color: var(--gold); }
  .tag--mild { background: rgba(138, 122, 106, 0.18); color: var(--ink-muted); }
  .tag--vegetarian,
  .tag--vegan { background: rgba(168, 213, 181, 0.14); color: #a8d5b5; }
  .tag--gluten-free { background: rgba(253, 246, 236, 0.1); color: var(--cream); }
  .tag--high-protein { background: rgba(244, 162, 97, 0.14); color: var(--ember); }

  /* Right side: heat meter, cal, price, add button stacked */
  .item-side {
    display: grid;
    grid-template-columns: auto;
    gap: 6px;
    text-align: right;
    align-items: end;
    min-width: 120px;
  }
  .item-heat {
    display: inline-flex;
    gap: 2px;
    font-size: 0.9rem;
    justify-self: end;
  }
  .item-heat .hd { color: var(--crimson); }
  .item-heat .hd-off { color: var(--ink-muted); }
  .item-cal {
    font-size: 0.72rem;
    color: var(--ink-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .item-price {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--gold);
  }
  .item-add {
    display: inline-block;
    margin-top: 6px;
    padding: 6px 14px;
    background: var(--crimson);
    color: #fff;
    border-radius: 4px;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    justify-self: end;
    transition: background 0.15s ease;
  }
  .item-add:hover { background: var(--chili); }

  /* List CTA */
  .list-cta {
    margin-top: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 32px;
    background: linear-gradient(135deg, var(--crimson-deep) 0%, var(--crimson) 100%);
    border-radius: 10px;
    flex-wrap: wrap;
  }
  .list-cta h3 {
    font-size: 1.3rem;
    color: #fff;
    margin-bottom: 4px;
  }
  .list-cta p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .menu-grid { grid-template-columns: 1fr; gap: 28px; }
    .menu-rail { position: static; }
    .rail-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px;
      border-left: none;
      padding-left: 0;
    }
    .rail-nav a {
      padding: 6px 10px;
      background: var(--charcoal);
      border-radius: 4px;
      border-bottom: none;
    }
    .item-row { grid-template-columns: 1fr; gap: 14px; }
    .item-side {
      grid-template-columns: auto auto auto auto;
      text-align: left;
      align-items: center;
      gap: 14px;
      justify-content: flex-start;
    }
    .item-heat, .item-add { justify-self: start; }
  }
</style>
