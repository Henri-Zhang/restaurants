---
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const relPath = pathname.startsWith(base)
  ? "/" + pathname.slice(base.length)
  : pathname;
const isActive = (path: string) =>
  path === "/" ? relPath === "/" : relPath.startsWith(path);
---

<header class="site-header">
  <div class="container header-inner">
    <a href={base} class="logo" aria-label="Spice Pit home">
      <span class="logo-flame">🔥</span>
      <span class="logo-text">Spice&nbsp;Pit</span>
    </a>

    <nav class="nav-desktop">
      <a href={base} class:list={["nav-link", { active: isActive("/") }]}>Home</a>
      <a href={`${base}menu/`} class:list={["nav-link", { active: isActive("/menu") }]}>Menu</a>
      <a href={`${base}#vibe`} class="nav-link">The Vibe</a>
      <a href={`${base}#private`} class="nav-link">Private Rooms</a>
    </nav>

    <a href={`${base}menu/`} class="btn btn--fire reserve-btn">Book a Pot</a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="nav-mobile">
    <a href={base}>Home</a>
    <a href={`${base}menu/`}>Menu</a>
    <a href={`${base}#vibe`}>The Vibe</a>
    <a href={`${base}#private`}>Private Rooms</a>
    <a href={`${base}menu/`} class="btn btn--fire" style="margin-top:12px;">Book a Pot</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const mobile = document.querySelector(".nav-mobile");
  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(!!open));
  });
  document.querySelectorAll(".nav-mobile a").forEach((a) =>
    a.addEventListener("click", () => {
      mobile?.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    }),
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(12, 10, 9, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-strong);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 24px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 1.35rem;
    color: var(--gold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .logo-flame {
    font-size: 1.2rem;
  }

  .nav-desktop {
    display: flex;
    gap: 36px;
    margin-left: auto;
    margin-right: 16px;
  }

  .nav-link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--cream);
    position: relative;
    padding: 4px 0;
    transition: color 0.15s ease;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background: var(--crimson);
    transition: width 0.2s ease;
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }
  .nav-link.active {
    color: var(--gold);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--cream);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: 16px 24px 24px;
    background: var(--charcoal);
    border-bottom: 1px solid var(--border-strong);
  }
  .nav-mobile.open {
    display: flex;
  }
  .nav-mobile a {
    padding: 10px 0;
    font-weight: 600;
    color: var(--cream);
    border-bottom: 1px solid var(--border);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
  }
  .nav-mobile a:last-of-type {
    border-bottom: none;
  }

  @media (max-width: 768px) {
    .nav-desktop,
    .reserve-btn {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>
