---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;

const timeline = [
  {
    year: "1984",
    cname: "起家",
    title: "A dai pai dong on Wellington Street",
    desc: "Lotus House began as a street-side stall serving congee and youtiao to morning commuters in Central.",
  },
  {
    year: "1996",
    cname: "扎根",
    title: "The first dining room",
    desc: "We moved indoors, hired our first dim sum chef, and installed the red vinyl booths regulars still ask for.",
  },
  {
    year: "2011",
    cname: "传承",
    title: "The second generation",
    desc: "The founder’s daughter took over, keeping the recipes while refining the room for longer, slower lunches.",
  },
  {
    year: "Today",
    cname: "如今",
    title: "Still family-run",
    desc: "We still open at six to steam the first baskets by hand. Some things do not need to change.",
  },
];

const values = [
  {
    title: "Handmade every morning",
    cname: "手工",
    desc: "Our har gow wrappers are rolled by hand, our char siu is glazed in-house, and our broth simmers overnight.",
  },
  {
    title: "Tea as the anchor",
    cname: "以茶为本",
    desc: "Tea is not a beverage choice. It resets the palate, paces the meal, and turns lunch into a ritual.",
  },
  {
    title: "Seasonal, not trendy",
    cname: "不时不食",
    desc: "We follow the Cantonese calendar: grouper in winter, hairy crab in autumn, the best loquats in spring.",
  },
];
---

<Layout title="Our Story — Lotus House">
  <Header />

  <main>
    <!-- Hero -->
    <section class="story-hero">
      <div class="story-hero-lattice" aria-hidden="true"></div>
      <div class="container">
        <p class="eyebrow" style="text-align: center; color: var(--gold);">
          Since 1984
        </p>
        <h1>
          <span class="story-title-en">Our Story</span>
          <span class="story-title-cn">缘起</span>
        </h1>
        <p class="story-hero-sub">
          Lotus House is a family-run Cantonese tea house. We believe the best
          meals are the ones that refuse to end.
        </p>
      </div>
    </section>

    <!-- Intro -->
    <section class="section intro">
      <div class="container intro-grid">
        <div class="intro-visual">
          <div class="intro-seal">莲</div>
          <div class="intro-vertical">一盅两件</div>
        </div>
        <div class="intro-copy">
          <p class="eyebrow">The Beginning</p>
          <h2>Yum cha taught us how to feed a neighborhood.</h2>
          <p>
            In Hong Kong, yum cha is not just brunch — it is a social contract.
            Families gather, trolleys circle, and the tea pot is refilled until
            the conversation runs dry. Our founder learned this rhythm from her
            grandmother, who ran a small stall on Wellington Street in the
            1960s.
          </p>
          <p>
            We opened Lotus House to preserve that rhythm. No timers, no rush.
            Just bamboo baskets, iron teapots, and the understanding that a meal
            can last as long as it needs to.
          </p>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="section timeline">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Timeline</p>
          <h2>Four decades, one kitchen.</h2>
        </div>
        <div class="timeline-grid">
          {timeline.map((item, i) => (
            <article class="timeline-card">
              <div class="timeline-marker" aria-hidden="true"></div>
              <span class="timeline-year">{item.year}</span>
              <span class="timeline-cname">{item.cname}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="section values" id="values">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">Our Values</p>
          <h2>The house rules.</h2>
        </div>
        <div class="values-grid">
          {values.map((v) => (
            <article class="value-card">
              <div class="value-top">
                <h3>{v.title}</h3>
                <span class="value-cname">{v.cname}</span>
              </div>
              <p>{v.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Quote -->
    <section class="section quote-section">
      <div class="container">
        <blockquote class="quote-block">
          <p>“Good dim sum is not about how many baskets you can make. It is about how many regulars come back for the same taste.”</p>
          <footer>
            <span class="quote-author">Madam Lo, founder</span>
            <span class="quote-cname">卢老太</span>
          </footer>
        </blockquote>
      </div>
    </section>

    <!-- CTA -->
    <section class="section story-cta">
      <div class="container">
        <div class="cta-panel">
          <h2>Come sit with us.</h2>
          <p>
            Whether it is your first yum cha or your five-hundredth, there is
            always room at the table.
          </p>
          <div class="cta-actions">
            <a href={`${base}menu/`} class="btn btn--cinnabar">View the menu</a>
            <a href={`${base}#book`} class="btn btn--ink">Reserve a table</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .story-hero {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    padding: 120px 0 80px;
    text-align: center;
    overflow: hidden;
  }
  .story-hero-lattice {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
    width: 520px;
    height: 520px;
    opacity: 0.1;
    border: 1px solid var(--gold);
    background:
      linear-gradient(var(--gold), var(--gold)) center / 33.33% 1px no-repeat,
      linear-gradient(var(--gold), var(--gold)) center / 1px 33.33% no-repeat;
  }
  .story-hero h1 {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: 18px 0 22px;
  }
  .story-title-en {
    font-size: clamp(2.4rem, 6vw, 4.4rem);
  }
  .story-title-cn {
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 1.1rem;
    color: var(--cinnabar);
    letter-spacing: 0.5em;
  }
  .story-hero-sub {
    position: relative;
    max-width: 540px;
    margin: 0 auto;
    color: rgba(247, 244, 237, 0.7);
    font-size: 1.1rem;
  }

  /* Intro */
  .intro {
    background: var(--paper);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 72px;
    align-items: center;
  }
  .intro-visual {
    position: relative;
    height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper-warm);
    border: 1px solid var(--border);
  }
  .intro-visual::before {
    content: "";
    position: absolute;
    inset: 14px;
    border: 1px solid var(--border-gold);
  }
  .intro-seal {
    width: 120px;
    height: 120px;
    background: var(--cinnabar);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 3rem;
    border-radius: 6px;
    box-shadow: inset 0 0 0 4px rgba(255, 255, 255, 0.18);
  }
  .intro-vertical {
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 1.2rem;
    color: var(--cinnabar);
    letter-spacing: 0.4em;
  }
  .intro-copy h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    margin: 12px 0 20px;
  }
  .intro-copy p {
    color: var(--ink-muted);
    margin-bottom: 16px;
    font-size: 1.02rem;
  }

  /* Timeline */
  .timeline {
    background: var(--paper-warm);
  }
  .section-head {
    text-align: center;
    margin-bottom: 56px;
  }
  .section-head h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-top: 12px;
  }
  .timeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }
  .timeline-card {
    background: var(--paper);
    border: 1px solid var(--border);
    padding: 32px 24px;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .timeline-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px var(--shadow);
  }
  .timeline-marker {
    width: 10px;
    height: 10px;
    background: var(--cinnabar);
    border-radius: 50%;
    margin-bottom: 18px;
  }
  .timeline-year {
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 1.3rem;
    color: var(--gold);
    font-weight: 600;
    display: block;
    margin-bottom: 4px;
  }
  .timeline-cname {
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 0.85rem;
    color: var(--cinnabar);
    display: block;
    margin-bottom: 12px;
  }
  .timeline-card h3 {
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .timeline-card p {
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  /* Values */
  .values {
    background: var(--paper);
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .value-card {
    border-top: 2px solid var(--cinnabar);
    padding-top: 28px;
  }
  .value-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 14px;
  }
  .value-top h3 {
    font-size: 1.25rem;
  }
  .value-cname {
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 0.9rem;
    color: var(--cinnabar);
    white-space: nowrap;
  }
  .value-card p {
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  /* Quote */
  .quote-section {
    background: var(--paper-warm);
  }
  .quote-block {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    border: 1px solid var(--border-gold);
    padding: 64px 48px;
    position: relative;
  }
  .quote-block::before,
  .quote-block::after {
    content: "“";
    position: absolute;
    font-family: Georgia, serif;
    font-size: 6rem;
    color: var(--gold);
    opacity: 0.35;
    line-height: 1;
  }
  .quote-block::before {
    top: 18px;
    left: 24px;
  }
  .quote-block::after {
    content: "”";
    bottom: 6px;
    right: 24px;
  }
  .quote-block p {
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    line-height: 1.5;
    margin-bottom: 28px;
    position: relative;
    z-index: 1;
  }
  .quote-block footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .quote-author {
    font-weight: 700;
    color: var(--cinnabar);
  }
  .quote-cname {
    font-family: Georgia, "Noto Serif SC", serif;
    color: var(--ink-muted);
  }

  /* CTA */
  .story-cta {
    background: var(--paper);
  }
  .cta-panel {
    text-align: center;
    padding: 72px;
    background: var(--ink);
    color: var(--paper);
  }
  .cta-panel h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin-bottom: 14px;
  }
  .cta-panel p {
    color: rgba(247, 244, 237, 0.7);
    max-width: 520px;
    margin: 0 auto 28px;
    font-size: 1.05rem;
  }
  .cta-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .intro-visual {
      height: 280px;
    }
    .timeline-grid {
      grid-template-columns: 1fr 1fr;
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
    .cta-panel {
      padding: 48px 32px;
    }
  }
</style>
