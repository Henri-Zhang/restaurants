---
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const relPath = pathname.startsWith(base)
  ? "/" + pathname.slice(base.length)
  : pathname;
const isActive = (path: string) =>
  path === "/" ? relPath === "/" : relPath.startsWith(path);
---

<header class="site-header">
  <div class="header-rule" aria-hidden="true"></div>
  <div class="container header-inner">
    <a href={base} class="logo" aria-label="Lotus House home">
      <span class="logo-seal">莲</span>
      <span class="logo-text">
        <span class="logo-en">Lotus House</span>
        <span class="logo-cn">莲香楼</span>
      </span>
    </a>

    <nav class="nav-desktop">
      <a href={base} class:list={["nav-link", { active: isActive("/") }]}>Home</a>
      <a href={`${base}menu/`} class:list={["nav-link", { active: isActive("/menu") }]}>Menu</a>
      <a href={`${base}story/`} class:list={["nav-link", { active: isActive("/story") }]}>Story</a>
      <a href={`${base}#book`} class="nav-link">Book</a>
    </nav>

    <a href={`${base}#book`} class="btn btn--cinnabar reserve-btn">Reserve</a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav class="nav-mobile">
    <a href={base}>Home</a>
    <a href={`${base}menu/`}>Menu</a>
    <a href={`${base}story/`}>Story</a>
    <a href={`${base}#book`}>Book a Table</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector(".nav-toggle");
  const mobile = document.querySelector(".nav-mobile");
  toggle?.addEventListener("click", () => {
    const open = mobile?.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(!!open));
  });
  document.querySelectorAll(".nav-mobile a").forEach((a) =>
    a.addEventListener("click", () => {
      mobile?.classList.remove("open");
      toggle?.setAttribute("aria-expanded", "false");
    }),
  );
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(247, 244, 237, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .header-rule {
    height: 3px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--cinnabar) 20%,
      var(--gold) 50%,
      var(--cinnabar) 80%,
      transparent 100%
    );
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    gap: 28px;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .logo-seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: var(--cinnabar);
    color: #fff;
    font-family: Georgia, "Noto Serif SC", serif;
    font-size: 1.15rem;
    border-radius: 3px;
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.2);
  }
  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .logo-en {
    font-family: Georgia, "Noto Serif SC", serif;
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  .logo-cn {
    font-size: 0.72rem;
    color: var(--cinnabar);
    letter-spacing: 0.25em;
    margin-top: 2px;
  }

  .nav-desktop {
    display: flex;
    gap: 36px;
    margin-left: auto;
    margin-right: 18px;
  }

  .nav-link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink-muted);
    position: relative;
    padding: 6px 2px;
    transition: color 0.2s ease;
    letter-spacing: 0.04em;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 1.5px;
    background: var(--cinnabar);
    transition: width 0.2s ease;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--cinnabar);
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--ink);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: 16px 28px 28px;
    background: var(--paper-warm);
    border-top: 1px solid var(--border);
  }
  .nav-mobile.open {
    display: flex;
  }
  .nav-mobile a {
    padding: 12px 0;
    font-weight: 600;
    color: var(--ink);
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
  }
  .nav-mobile a:last-of-type {
    border-bottom: none;
    color: var(--cinnabar);
  }

  @media (max-width: 768px) {
    .nav-desktop,
    .reserve-btn {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>
